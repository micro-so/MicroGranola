# Copy this file to .env.local. Never commit or share .env.local.
# Leave the keys blank to explore demo data without connecting an account.

# Required for live Micro data. Use a key and team ID for the same workspace.
# Create a key in https://app.micro.so/console
MICRO_API_KEY=
MICRO_TEAM_ID=

# Display name shown in the sidebar and workspace labels (not fetched automatically).
MICRO_WORKSPACE_NAME="My workspace"

# Your own email address. Required for your calendar; also used in meeting views.
MICRO_ME_EMAIL=

# Optional: production keys use https://developers.micro.so by default.
# Staging keys need MICRO_BASE_URL=https://developers.staging.micro.so
MICRO_BASE_URL=

# Optional: your Granola API key, for Granola notes and folders.
GRANOLA_API_KEY=

# Optional: local demo fixtures. Leave blank for a normal setup.
LOCAL_EMAIL_ACTIVITY_PATH=
LOCAL_IMESSAGE_ACTIVITY_PATH=
